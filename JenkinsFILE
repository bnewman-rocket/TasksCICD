pipeline {
    agent any

    triggers {
        pollSCM("* * * * *")
    }

    stages {
        stage("Debug") {
            steps {
                bat "dir"
                bat "dir scripts"
            }
        },

        stage("Checkout") {
            steps {
                checkout scm
            }
        }

        stage("Compile And Run") {
            steps {
                bat "call scripts\\compile_and_run.bat"
            }
        }
    }
}